{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-systems-lab/create-ticket.output.schema.json",
  "title": "Create ticket tool result",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "ticket": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "priority": { "enum": ["low", "normal", "high"] }
          },
          "required": ["id", "title", "priority"],
          "additionalProperties": false
        }
      },
      "required": ["ok", "ticket"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ok": { "const": false },
        "error": { "type": "string", "minLength": 1 }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    }
  ]
}
